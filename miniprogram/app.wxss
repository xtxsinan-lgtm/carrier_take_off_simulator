/** 全局样式：深色主题 + 安全区 + rpx 布局基准（750 设计宽） */

page {
  --bg: #0f1419;
  --surface: #1a2332;
  --surface2: #243044;
  --border: #334155;
  --text: #e2e8f0;
  --muted: #94a3b8;
  --accent: #38bdf8;
  --accent-dim: #0ea5e9;
  --success: #4ade80;
  --danger: #f87171;
  --radius: 16rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 16rpx 8rpx 32rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 24rpx;
  letter-spacing: 0.02em;
}

.card-hint {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.65;
  margin-top: 16rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--surface2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 28rpx;
}

.field-input.readonly {
  color: var(--muted);
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--surface2);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 28rpx;
}

.picker-arrow {
  color: var(--muted);
  font-size: 22rpx;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn {
  flex: 1;
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dim) 100%);
  color: #0f172a;
}

.btn-primary[disabled] {
  opacity: 0.5;
  color: #0f172a;
}

.btn-secondary {
  background: var(--surface2);
  color: var(--text);
  border: 1rpx solid var(--border);
}

.status-bar {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  background: var(--surface2);
  color: var(--muted);
}

.status-bar.ok {
  color: var(--success);
  border: 1rpx solid rgba(74, 222, 128, 0.35);
}

.status-bar.error {
  color: var(--danger);
  border: 1rpx solid rgba(248, 113, 113, 0.35);
}

.status-bar.loading {
  color: var(--accent);
  border: 1rpx solid rgba(56, 189, 248, 0.35);
}

.output-pre {
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text);
  font-family: monospace;
  max-height: 480rpx;
  overflow-y: auto;
}

.output-pre.empty {
  color: var(--muted);
}

.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  background: rgba(56, 189, 248, 0.15);
  color: var(--accent);
  margin-left: 8rpx;
}

.grid-3 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-3 .grid-item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
}

.page-footer {
  padding: 16rpx 8rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
