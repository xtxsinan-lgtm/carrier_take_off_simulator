.mode-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mode-btn {
  width: 100%;
  padding: 22rpx 28rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #243044;
  color: #94a3b8;
  border: 1rpx solid #334155;
}

.mode-btn.active {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border-color: #38bdf8;
  font-weight: 600;
}

@media (min-width: 360px) {
  .mode-group {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .mode-btn {
    flex: 1 1 calc(33.33% - 12rpx);
    min-width: calc(50% - 8rpx);
  }
}

@media (min-width: 414px) {
  .mode-btn {
    flex: 1 1 calc(33.33% - 12rpx);
    min-width: calc(33.33% - 12rpx);
  }
}
