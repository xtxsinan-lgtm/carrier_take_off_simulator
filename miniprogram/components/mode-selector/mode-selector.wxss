.mode-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mode-btn {
  width: 100%;
  padding: 22rpx 28rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #243044;
  color: #94a3b8;
  border: 2rpx solid #334155;
  box-sizing: border-box;
}

.mode-btn.active {
  background: rgba(56, 189, 248, 0.18);
  color: #38bdf8;
  border-color: #38bdf8;
  font-weight: 600;
}
