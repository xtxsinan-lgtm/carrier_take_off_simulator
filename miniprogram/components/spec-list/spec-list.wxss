.spec-list {
  margin-top: 8rpx;
}

.spec-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #334155;
}

.spec-row:last-child {
  border-bottom: none;
}

.spec-label {
  flex: 0 0 48%;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
  letter-spacing: 1rpx;
  font-family: Courier New, monospace;
}

.spec-value {
  flex: 1;
  font-size: 22rpx;
  color: #e2e8f0;
  text-align: right;
  line-height: 1.5;
  word-break: break-all;
  font-family: Courier New, monospace;
}

.spec-empty {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 16rpx 0;
  font-family: Courier New, monospace;
}
