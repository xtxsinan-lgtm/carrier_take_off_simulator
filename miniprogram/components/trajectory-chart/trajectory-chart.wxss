.trajectory-wrap {
  margin-top: 8rpx;
}

.trajectory-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.trajectory-meta {
  display: block;
  font-size: 22rpx;
  color: #38bdf8;
  margin-bottom: 16rpx;
}

.trajectory-canvas {
  display: block;
  border-radius: 12rpx;
  border: 1rpx solid #334155;
  background: #1a2332;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
}

.legend-item {
  font-size: 20rpx;
  color: #94a3b8;
  padding-left: 24rpx;
  position: relative;
}

.legend-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-item.deck::before {
  background: #64748b;
}

.legend-item.path::before {
  background: #38bdf8;
}

.legend-item.limit::before {
  background: #f87171;
  border-radius: 2rpx;
  width: 4rpx;
  height: 16rpx;
}

.legend-item.start::before {
  background: #4ade80;
}

.legend-item.exit::before {
  background: #fb923c;
}

.legend-item.end::before {
  background: #fbbf24;
}
