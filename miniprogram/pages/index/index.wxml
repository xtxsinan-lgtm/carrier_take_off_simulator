<view class="page">
  <view class="page-header">
    <text class="page-title">航母舰载机起飞仿真</text>
    <text class="page-subtitle">支持滑跃、短距、短距滑跃、倾转短距 · 手机端自适应布局</text>
  </view>

  <view class="status-bar {{statusClass}}" wx:if="{{statusText}}" style="margin: 0 0 24rpx;">{{statusText}}</view>

  <!-- 1. 起飞模式 -->
  <view class="card">
    <text class="card-title">1. 起飞模式</text>
    <mode-selector modeList="{{modeList}}" current="{{currentMode}}" bind:change="onModeChange" />
    <text class="card-hint">
      滑跃 / 短距滑跃需滑跃甲板；短距 / 倾转短距需平直甲板。
      倾转短距仅策略 A/B；轨迹图仅滑跃与短距滑跃成功后显示。
    </text>
    <block wx:if="{{showStrategy}}">
      <text class="card-title" style="margin-top: 24rpx;">{{strategyTitle}}</text>
      <mode-selector modeList="{{strategyList}}" current="{{currentStrategy}}" bind:change="onStrategyChange" />
    </block>
  </view>

  <!-- 2. 航母 -->
  <view class="card">
    <text class="card-title">2. 航母</text>
    <text class="field-label">选择航母</text>
    <picker
      mode="selector"
      range="{{carrierNames}}"
      value="{{carrierIndex}}"
      bindchange="onCarrierChange"
      disabled="{{carrierNames.length === 0}}"
    >
      <view class="picker-value">
        <text>{{carrierLabel || '请选择'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
    <spec-list items="{{carrierSpecs}}" emptyText="请选择航母" />

    <block wx:if="{{showSkiJump}}">
      <text class="card-hint">滑跃参数（修改角度或弧长后，唇口高度自动重算）：</text>
      <view class="grid-3 ski-grid">
        <view class="grid-item">
          <text class="field-label">滑跃角 (°)</text>
          <input class="field-input" type="digit" value="{{skiAngle}}" bindinput="onSkiAngleInput" />
        </view>
        <view class="grid-item">
          <text class="field-label">滑跃弧长 (m)</text>
          <input class="field-input" type="digit" value="{{skiArcLength}}" bindinput="onSkiArcInput" />
        </view>
        <view class="grid-item">
          <text class="field-label">唇口高度 (m)</text>
          <input class="field-input readonly" disabled value="{{skiHeight}}" />
        </view>
      </view>
      <text class="card-hint">滑跃水平投影：{{skiHorizontal}} m</text>
    </block>
  </view>

  <!-- 3. 战斗机 -->
  <view class="card">
    <text class="card-title">3. 战斗机</text>
    <text class="field-label">选择战斗机</text>
    <picker
      mode="selector"
      range="{{aircraftNames}}"
      value="{{aircraftIndex}}"
      bindchange="onAircraftChange"
      disabled="{{aircraftNames.length === 0}}"
    >
      <view class="picker-value">
        <text>{{aircraftLabel || '请选择'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
    <spec-list items="{{aircraftSpecs}}" emptyText="请选择战斗机" />
  </view>

  <!-- 4. 仿真条件 -->
  <view class="card">
    <text class="card-title">4. 仿真条件</text>
    <view class="grid-3">
      <view class="grid-item">
        <text class="field-label">甲板风 (kt)</text>
        <input class="field-input" type="digit" value="{{windKt}}" bindinput="onWindInput" />
      </view>
      <view class="grid-item">
        <text class="field-label">环境温度 (°C)</text>
        <input class="field-input" type="digit" value="{{tempC}}" bindinput="onTempInput" />
      </view>
      <view class="grid-item">
        <text class="field-label">起飞重量 (kg)</text>
        <input class="field-input" type="digit" value="{{massKg}}" bindinput="onMassInput" />
      </view>
    </view>
    <view class="btn-row">
      <button class="btn btn-primary" bindtap="onRunSimulation" disabled="{{running}}" loading="{{running}}">
        开始仿真
      </button>
    </view>
    <text class="card-hint" wx:if="{{!hasApi}}">
      提示：在 miniprogram/config.js 设置 apiBaseUrl，并运行 python3 apps/miniprogram_api.py 启动仿真服务。
    </text>
  </view>

  <!-- 5. 仿真输出 -->
  <view class="card">
    <text class="card-title">5. 仿真输出</text>
    <text class="output-pre {{outputEmpty ? 'empty' : ''}}">{{outputText}}</text>
  </view>

  <!-- 6. 起飞轨迹：跟在仿真输出后，随页面滚动（非底部固定坞） -->
  <view class="card" wx:if="{{showTrajectory}}">
    <text class="card-title">6. 起飞轨迹</text>
    <trajectory-chart result="{{simResult}}" heightRpx="{{trajHeightRpx}}" />
  </view>

  <view class="page-footer">
    仿真由 Python 物理模型计算 · 数据来自 aircraft_database.csv / carriers_database.csv
  </view>
</view>
