.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.page-root .page {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx 24rpx 12rpx;
}

.traj-dock {
  flex-shrink: 0;
  margin: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  max-height: 45vh;
  overflow-y: auto;
}

.ski-grid {
  margin-top: 16rpx;
}
